# Copy this file to "signing.env" (which git ignores) and fill in your own values.
# Keep the .jks key file OUTSIDE the project folder and back it up: every future
# update must be signed with this same key or phones will refuse to install it.
KEYSTORE="$HOME/keys/RadioFilm-Scanner-release-key.jks"
KEYSTORE_PASSWORD="change-me"
KEY_ALIAS="filmscan"
KEY_PASSWORD="change-me"
